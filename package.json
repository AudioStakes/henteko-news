{
  "name": "henteko-news",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "check:words": "node scripts/check-words.mjs",
    "sort:words": "node scripts/sort-words.mjs",
    "test:layout": "playwright test tests/layout",
    "test:e2e": "playwright test",
    "setup:speech": "node scripts/download-speech-assets.mjs",
    "check:speech-assets": "node scripts/download-speech-assets.mjs --check"
  },
  "dependencies": {
    "onnxruntime-web": "^1.23.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.7"
  }
}
