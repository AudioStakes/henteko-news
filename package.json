{
  "name": "henteko-news",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.18.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-runtime.mjs",
    "dev": "vite --config vite.config.ts",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --config vite.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "npm run lint:biome && npm run lint:eslint && npm run lint:docs",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:docs": "markdownlint --dot --config .markdownlint.jsonc \"**/*.md\"",
    "format": "biome check --write --error-on-warnings . && prettier --write .",
    "format:check": "biome check --error-on-warnings . && prettier --check .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:scripts && npm run check:words",
    "validate": "npm run check && npm run build",
    "typecheck": "tsc -b --noEmit",
    "check:words": "node scripts/check-words.mjs",
    "sort:words": "node scripts/sort-words.mjs",
    "test:layout": "playwright test tests/layout",
    "test:e2e": "playwright test",
    "setup:speech": "node scripts/download-speech-assets.mjs",
    "check:speech-assets": "node scripts/download-speech-assets.mjs --check"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.1",
      "smol-toml": "1.9.1",
      "katex": "0.18.2"
    }
  },
  "dependencies": {
    "onnxruntime-web": "^1.23.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
